{
  "name": "rip-tv-time",
  "version": "0.1.0",
  "description": "A self-hostable clone of TV Time to read and browse your exported watch history.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute rip_tv_time --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute rip_tv_time --remote --file=./schema.sql",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "wrangler": "^3.95.0"
  }
}
